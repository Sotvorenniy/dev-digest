{
  "mcpServers": {
    "devdigest": {
      "type": "stdio",
      "command": "${CLAUDE_PROJECT_DIR}/mcp/node_modules/.bin/tsx",
      "args": ["${CLAUDE_PROJECT_DIR}/mcp/src/index.ts"],
      "env": {
        "DEVDIGEST_API": "${DEVDIGEST_API:-http://localhost:3001}"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Readonly": "true"
      }
    }
  }
}

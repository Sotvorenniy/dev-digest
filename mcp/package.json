{
  "name": "@devdigest/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DevDigest MCP server: a local stdio wrapper over the dev-digest REST API (default http://localhost:3001).",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "measure": "tsx scripts/measure-tools.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

import { AppError } from '../../platform/errors.js';

export interface __Entity__ {
  id: string;
  workspaceId: string;
  name: string;
  createdAt: Date;
}

/** A business rule: true without a database and without HTTP. */
export function assertValidName(name: string): void {
  if (name.trim().length === 0) throw new AppError('invalid___name__', 'Name must not be empty', 422);
}

node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# agent working plans (implementation-planner output, deleted after the work is done)
.claude/plans/*
# kept for the L05 lab review: SDD pipeline artifacts (plan, run state, reports, review findings)
!.claude/plans/project-context.md
!.claude/plans/project-context/
!.claude/plans/onboarding-tour.md
!.claude/plans/onboarding-tour/

# vitest result cache (test durations and failures), regenerated on every run
.vite/
